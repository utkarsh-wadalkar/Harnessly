{
  "$defs": {
    "ArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "manifest",
            "patch",
            "stdout",
            "stderr",
            "trace",
            "grading",
            "usage",
            "environment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "redaction_status": {
          "enum": [
            "pending",
            "passed",
            "rejected"
          ],
          "title": "Redaction Status",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "attempt_id",
        "kind",
        "sha256",
        "size_bytes",
        "media_type",
        "redaction_status",
        "visibility"
      ],
      "title": "ArtifactManifest",
      "type": "object"
    },
    "ArtifactSubmission": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactManifest"
        },
        "fencing_token": {
          "exclusiveMinimum": 0,
          "title": "Fencing Token",
          "type": "integer"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        }
      },
      "required": [
        "lease_id",
        "fencing_token",
        "artifact"
      ],
      "title": "ArtifactSubmission",
      "type": "object"
    },
    "ArtifactUpload": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "expires_at": {
          "description": "Timezone-aware RFC3339 timestamp; store UTC.",
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "upload_url": {
          "description": "Short-lived owner/attempt-scoped upload URL.",
          "title": "Upload Url",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "upload_url",
        "expires_at"
      ],
      "title": "ArtifactUpload",
      "type": "object"
    },
    "AttemptCompletion": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactManifest"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "execution_status": {
          "enum": [
            "completed",
            "timeout",
            "cancelled",
            "resource_exhausted",
            "infrastructure_error",
            "harness_error",
            "model_error"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "fencing_token": {
          "exclusiveMinimum": 0,
          "title": "Fencing Token",
          "type": "integer"
        },
        "grading_outcome": {
          "enum": [
            "pass",
            "fail",
            "invalid_patch",
            "unavailable"
          ],
          "title": "Grading Outcome",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "lease_id",
        "fencing_token",
        "execution_status",
        "grading_outcome",
        "metrics",
        "artifacts"
      ],
      "title": "AttemptCompletion",
      "type": "object"
    },
    "AttemptLease": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "description": "Timezone-aware RFC3339 timestamp; store UTC.",
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "fencing_token": {
          "exclusiveMinimum": 0,
          "title": "Fencing Token",
          "type": "integer"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/AttemptManifest"
        }
      },
      "required": [
        "manifest",
        "lease_id",
        "fencing_token",
        "expires_at"
      ],
      "title": "AttemptLease",
      "type": "object"
    },
    "AttemptManifest": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "candidate": {
          "$ref": "#/$defs/CandidateConfiguration"
        },
        "experiment_id": {
          "format": "uuid",
          "title": "Experiment Id",
          "type": "string"
        },
        "network_policy_version": {
          "title": "Network Policy Version",
          "type": "string"
        },
        "normalization_version": {
          "title": "Normalization Version",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "prompt_policy_version": {
          "title": "Prompt Policy Version",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "retry_index": {
          "maximum": 1,
          "minimum": 0,
          "title": "Retry Index",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "sampling_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sampling Seed"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/TaskSelection"
        },
        "trial_index": {
          "minimum": 0,
          "title": "Trial Index",
          "type": "integer"
        },
        "worker_environment_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Environment Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "experiment_id",
        "plan_hash",
        "candidate",
        "task",
        "budgets",
        "trial_index",
        "retry_index",
        "sampling_seed",
        "prompt_policy_version",
        "prompt_sha256",
        "network_policy_version",
        "normalization_version",
        "worker_environment_sha256"
      ],
      "title": "AttemptManifest",
      "type": "object"
    },
    "AttemptProgress": {
      "additionalProperties": false,
      "properties": {
        "fencing_token": {
          "exclusiveMinimum": 0,
          "title": "Fencing Token",
          "type": "integer"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "enum": [
            "preparing",
            "executing",
            "grading"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "lease_id",
        "fencing_token",
        "status",
        "sequence"
      ],
      "title": "AttemptProgress",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "cpu_count": {
          "exclusiveMinimum": 0,
          "title": "Cpu Count",
          "type": "number"
        },
        "disk_mib": {
          "exclusiveMinimum": 0,
          "title": "Disk Mib",
          "type": "integer"
        },
        "inference_allowance_id": {
          "description": "Server-verified free-tier/paid allowance, not a client attestation.",
          "format": "uuid",
          "title": "Inference Allowance Id",
          "type": "string"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_log_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Log Bytes",
          "type": "integer"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_requests": {
          "exclusiveMinimum": 0,
          "title": "Max Requests",
          "type": "integer"
        },
        "memory_mib": {
          "exclusiveMinimum": 0,
          "title": "Memory Mib",
          "type": "integer"
        },
        "pids": {
          "exclusiveMinimum": 0,
          "title": "Pids",
          "type": "integer"
        },
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "cpu_count",
        "memory_mib",
        "disk_mib",
        "pids",
        "max_requests",
        "max_input_tokens",
        "max_output_tokens",
        "max_log_bytes",
        "inference_allowance_id"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "CandidateConfiguration": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "title": "Adapter Version",
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": {
            "enum": [
              "verified_supported",
              "verified_unsupported",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "effective_configuration_sha256": {
          "description": "Digest of the fully resolved, non-secret harness configuration.",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Effective Configuration Sha256",
          "type": "string"
        },
        "effective_sampling": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Actual supported sampling values applied by the adapter, not capability claims.",
          "title": "Effective Sampling",
          "type": "object"
        },
        "harness_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Harness Commit",
          "type": "string"
        },
        "harness_id": {
          "title": "Harness Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "runner_image": {
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "title": "Runner Image",
          "type": "string"
        },
        "unsupported_controls": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Controls",
          "type": "array"
        }
      },
      "required": [
        "id",
        "harness_id",
        "harness_commit",
        "adapter_version",
        "model",
        "runner_image",
        "capabilities",
        "effective_configuration_sha256"
      ],
      "title": "CandidateConfiguration",
      "type": "object"
    },
    "Criterion": {
      "enum": [
        "reliability",
        "speed",
        "monetary_cost",
        "token_efficiency",
        "autonomy",
        "control",
        "privacy"
      ],
      "title": "Criterion",
      "type": "string"
    },
    "DecisionEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "calibrated_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibrated Probability"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Version"
        },
        "candidate_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Candidate Ids",
          "type": "array"
        },
        "order_consistent": {
          "title": "Order Consistent",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "candidate_a",
            "candidate_b",
            "equivalent",
            "insufficient_evidence"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "profile_evidence": {
          "items": {
            "$ref": "#/$defs/PreferenceEvidence"
          },
          "title": "Profile Evidence",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "enum": [
              "reliability",
              "speed",
              "cost",
              "token_efficiency",
              "workflow",
              "control",
              "privacy",
              "coverage"
            ],
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "candidate_ids",
        "outcome",
        "reason_codes",
        "probabilities",
        "calibrated_probability",
        "calibration_version",
        "order_consistent",
        "artifact_ids",
        "profile_evidence"
      ],
      "title": "DecisionEvidence",
      "type": "object"
    },
    "DispatchRequest": {
      "additionalProperties": false,
      "properties": {
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "plan_hash"
      ],
      "title": "DispatchRequest",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "Error",
      "type": "object"
    },
    "ExecutionConditions": {
      "additionalProperties": false,
      "properties": {
        "network_policy_version": {
          "minLength": 1,
          "title": "Network Policy Version",
          "type": "string"
        },
        "normalization_version": {
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "prompt_policy_version": {
          "minLength": 1,
          "title": "Prompt Policy Version",
          "type": "string"
        },
        "prompt_snapshot_sha256": {
          "description": "Digest of resolved task/candidate prompt templates; excludes private preferences.",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Snapshot Sha256",
          "type": "string"
        },
        "trial_seeds": {
          "description": "One seed per trial; null explicitly records an unsupported control.",
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 3,
          "title": "Trial Seeds",
          "type": "array"
        }
      },
      "required": [
        "prompt_policy_version",
        "prompt_snapshot_sha256",
        "trial_seeds",
        "network_policy_version",
        "normalization_version"
      ],
      "title": "ExecutionConditions",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "description": "Timezone-aware RFC3339 timestamp; store UTC.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "personal",
            "global"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "partially_completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "terminal_runs": {
          "minimum": 0,
          "title": "Terminal Runs",
          "type": "integer"
        },
        "total_runs": {
          "exclusiveMinimum": 0,
          "title": "Total Runs",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "plan_id",
        "status",
        "scope",
        "total_runs",
        "terminal_runs",
        "created_at"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentPlan": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateConfiguration"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "created_at": {
          "description": "Timezone-aware RFC3339 timestamp; store UTC.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "execution_conditions": {
          "$ref": "#/$defs/ExecutionConditions"
        },
        "expires_at": {
          "description": "Timezone-aware RFC3339 timestamp; store UTC.",
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "profile_version_id": {
          "format": "uuid",
          "title": "Profile Version Id",
          "type": "string"
        },
        "requested_attempts": {
          "exclusiveMinimum": 0,
          "title": "Requested Attempts",
          "type": "integer"
        },
        "scope": {
          "enum": [
            "personal",
            "global"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "dispatched",
            "expired",
            "invalidated"
          ],
          "title": "Status",
          "type": "string"
        },
        "suite_version": {
          "title": "Suite Version",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSelection"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "trials": {
          "minimum": 3,
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner_id",
        "profile_version_id",
        "suite_version",
        "candidates",
        "tasks",
        "trials",
        "scope",
        "budgets",
        "execution_conditions",
        "plan_hash",
        "created_at",
        "expires_at",
        "status",
        "requested_attempts",
        "estimated_cost_usd"
      ],
      "title": "ExperimentPlan",
      "type": "object"
    },
    "HardConstraint": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "local_inference",
            "approval_control",
            "max_elapsed_seconds",
            "max_cost_usd",
            "language",
            "os"
          ],
          "title": "Key",
          "type": "string"
        },
        "origin": {
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Origin",
          "type": "string"
        },
        "user_confirmed": {
          "title": "User Confirmed",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value",
        "origin",
        "user_confirmed"
      ],
      "title": "HardConstraint",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Health",
      "type": "object"
    },
    "Interview": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "awaiting_confirmation",
            "completed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "model_id",
        "status"
      ],
      "title": "Interview",
      "type": "object"
    },
