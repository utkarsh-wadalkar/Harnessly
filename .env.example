# Copy to ignored .env. Keep provider credentials out of source control and traces.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://harnessarena:REPLACE_LOCALLY@127.0.0.1:5432/harnessarena
LAYA_API_KEY=
LAYA_BASE_URL=http://127.0.0.1:8001
# A future Compose API uses http://laya:8000 on the private decision network.
LAYA_SHA256_DIGESTS=
HF_HUB_OFFLINE=0
# Local infrastructure startup waits up to 900 seconds for both health checks.
# Override only the script's --wait-timeout / -WaitTimeout if the first model download needs longer.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_FREE_TIER_VERIFIED=false
GEMMA_ALLOWANCE_EVIDENCE=.local/gemma-allowance.json
# Keep the source/reference for verified Gemma model access and request allowance in private evidence.
GEMMA_ALLOWANCE_EVIDENCE_REF=
GEMMA_MAX_REQUESTS=12
GEMMA_MAX_INPUT_TOKENS=12000
GEMMA_MAX_OUTPUT_TOKENS=2000
CODING_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
CODING_ENDPOINT=
# For a gateway running in Docker, a host-local source uses host.docker.internal.
# The model catalog probe derives this value from CODING_ENDPOINT without changing it.
CODING_CONTAINER_ENDPOINT=
CODING_API_KEY=
CODING_FREE_TIER_VERIFIED=false
BENCHMARK_CONCURRENCY=1
BENCHMARK_WALL_SECONDS=300
BENCHMARK_CPU_COUNT=1
BENCHMARK_MEMORY_MIB=2048
BENCHMARK_DISK_MIB=1024
BENCHMARK_PIDS=128
BENCHMARK_MAX_REQUESTS=20
BENCHMARK_MAX_INPUT_TOKENS=32000
BENCHMARK_MAX_OUTPUT_TOKENS=8000
BENCHMARK_MAX_LOG_BYTES=1048576
ARTIFACT_ROOT=.local/artifacts
# No free-tier eligibility or paid allowance is inferred from these examples.
